@page
@model MarketPlace.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="text-center">Register</h3>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="RegisterRequest.FirstName" class="form-label">First Name</label>
                                <input asp-for="RegisterRequest.FirstName" class="form-control" />
                                <span asp-validation-for="RegisterRequest.FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="RegisterRequest.LastName" class="form-label">Last Name</label>
                                <input asp-for="RegisterRequest.LastName" class="form-control" />
                                <span asp-validation-for="RegisterRequest.LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="RegisterRequest.Email" class="form-label">Email</label>
                        <input asp-for="RegisterRequest.Email" class="form-control" type="email" />
                        <span asp-validation-for="RegisterRequest.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="RegisterRequest.DisplayName" class="form-label">Display Name</label>
                        <input asp-for="RegisterRequest.DisplayName" class="form-control" />
                        <span asp-validation-for="RegisterRequest.DisplayName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="RegisterRequest.Password" class="form-label">Password</label>
                        <input asp-for="RegisterRequest.Password" class="form-control" type="password" />
                        <span asp-validation-for="RegisterRequest.Password" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="RegisterRequest.ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="RegisterRequest.ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="RegisterRequest.ConfirmPassword" class="text-danger"></span>
                    </div>
                    
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Register</button>
                    </div>
                </form>
                
                <div class="text-center mt-3">
                    <p>Already have an account? <a asp-page="/Auth/Login">Login here</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
